class IDEStats:

    def __init__(self):

        self.lock = threading.Lock()

        self.start_time = time.time()

        self.file_reads = 0

        self.file_writes = 0

        self.commands_run = 0

        self.git_ops = 0

        self.builds = 0

        self.history = []



    def add(self, op_type, detail):

        with self.lock:

            self.history.append({

                "type": op_type, "detail": detail,

                "ts": datetime.now(timezone.utc).isoformat()

            })

            self.history = self.history[-100:]

            if op_type == "read": self.file_reads += 1

            elif op_type == "write": self.file_writes += 1

            elif op_type == "cmd": self.commands_run += 1

            elif op_type == "git": self.git_ops += 1

            elif op_type == "build": self.builds += 1



    def to_dict(self):

        with self.lock:

            return {

                "uptime": round(time.time() - self.start_time, 2),

                "file_reads": self.file_reads,

                "file_writes": self.file_writes,

                "commands_run": self.commands_run,

                "git_ops": self.git_ops,

                "builds": self.builds,

                "history": self.history[-20:],

                "apis_count": len(NEXUS_APIS),

            }



STATS = IDEStats()



