    if (e.key === 'Tab') {

      e.preventDefault();

      const start = area.selectionStart;

      const end = area.selectionEnd;

      area.value = area.value.substring(0, start) + '    ' + area.value.substring(end);

      area.selectionStart = area.selectionEnd = start + 4;

    }

  });



  area.addEventListener('scroll', () => {

