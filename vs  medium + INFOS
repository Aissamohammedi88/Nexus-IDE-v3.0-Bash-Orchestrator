def get_file_tree(base_path):

    """Retourne l'arbre des fichiers"""

    tree = []

    base = Path(base_path)

    if not base.exists():

        return tree

    try:

        for item in sorted(base.iterdir(), key=lambda x: (x.is_file(), x.name)):

            if item.name.startswith(".") or item.name == "node_modules":

                continue

            if item.is_dir():

                tree.append({

                    "name": item.name,

                    "type": "folder",

                    "path": str(item.relative_to(base)),

                    "children": get_file_tree(item)

                })

            else:

                tree.append({

                    "name": item.name,

                    "type": "file",

                    "path": str(item.relative_to(base)),

                    "size": item.stat().st_size,

                    "ext": item.suffix

                })

    except Exception:

        pass

    return tree



def read_file_safe(path):

    """Lit un fichier de manière sécurisée"""

    try:

        full = WORKSPACE_DIR / path

        if not full.resolve().is_relative_to(WORKSPACE_DIR.resolve()):

            return None

        if not full.exists() or not full.is_file():

            return None

        if full.stat().st_size > 1_000_000:

            return None

        with open(full, "r", encoding="utf-8", errors="replace") as f:

            content = f.read()

        STATS.add("read", path)

        return content

    except Exception:

        return None



def write_file_safe(path, content):

    """Écrit un fichier de manière sécurisée"""

    try:

        full = WORKSPACE_DIR / path

        if not full.resolve().is_relative_to(WORKSPACE_DIR.resolve()):

            return False

        full.parent.mkdir(parents=True, exist_ok=True)

        with open(full, "w", encoding="utf-8") as f:

            f.write(content)

        STATS.add("write", path)

        return True

    except Exception:

        return False



def run_command(cmd, cwd=None, timeout=EXEC_TIMEOUT):

    """Exécute une commande système"""

    try:

        STATS.add("cmd", cmd)

        result = subprocess.run(

            shlex.split(cmd) if isinstance(cmd, str) else cmd,

            capture_output=True, text=True, timeout=timeout,

            cwd=cwd or str(WORKSPACE_DIR)

        )

        return {

            "stdout": result.stdout[:MAX_OUTPUT],

            "stderr": result.stderr[:MAX_OUTPUT],

            "exit_code": result.returncode,

            "success": result.returncode == 0

        }

    except subprocess.TimeoutExpired:

        return {"stdout": "", "stderr": f"Timeout {timeout}s", "exit_code": 124, "success": False}

    except FileNotFoundError as e:

        return {"stdout": "", "stderr": f"Commande introuvable: {e}", "exit_code": 127, "success": False}

    except Exception as e:

        return {"stdout": "", "stderr": str(e), "exit_code": 1, "success": False}



def git_status():

    """Retourne le statut git"""

    if not (WORKSPACE_DIR / ".git").exists():

        return {"initialized": False, "branch": None, "changes": []}

    r = run_command("git status --porcelain")

    b = run_command("git branch --show-current")

    return {

        "initialized": True,

        "branch": b["stdout"].strip(),

        "changes": r["stdout"].strip().split("\n") if r["stdout"].strip() else []

    }



def git_pull():

    STATS.add("git", "pull")

    return run_command("git pull")



def git_push():

    STATS.add("git", "push")

    return run_command("git push")



def git_commit(message):

    STATS.add("git", "commit")

    return run_command(f'git commit -m "{message}"')



def git_init():

    return run_command("git init")



def build_project(build_type="auto"):

    """Build le projet selon le type détecté"""

    STATS.add("build", build_type)

    if (WORKSPACE_DIR / "CMakeLists.txt").exists():

        return run_command("cmake -B build && cmake --build build")

    elif (WORKSPACE_DIR / "Cargo.toml").exists():

        return run_command("cargo build --release")

    elif (WORKSPACE_DIR / "go.mod").exists():

        return run_command("go build ./...")

    elif (WORKSPACE_DIR / "package.json").exists():

        return run_command("npm install && npm run build")

    elif (WORKSPACE_DIR / "pom.xml").exists():

        return run_command("mvn clean install")

    elif (WORKSPACE_DIR / "composer.json").exists():

        return run_command("composer install")

    elif (WORKSPACE_DIR / "requirements.txt").exists():

        return run_command("pip install -r requirements.txt")

    elif (WORKSPACE_DIR / "Makefile").exists():

        return run_command("make")

    else:

        return {"stdout": "", "stderr": "Aucun fichier de build détecté", "exit_code": 1, "success": False}



def run_nexus_tool(tool_name, args=""):

    """Exécute un outil NEXUS"""

    if tool_name not in NEXUS_APIS:

        return {"stdout": "", "stderr": f"Outil inconnu: {tool_name}", "exit_code": 1, "success": False}

    tool = NEXUS_APIS[tool_name]

    cmd = tool["cmd"]

    if args:

        cmd = f"{cmd} {args}"

    # Vérifier si l'outil est installé

    binary = cmd.split()[0]

    if shutil.which(binary):

        return run_command(cmd)

    else:

        return {

            "stdout": f"⚠️ {tool['name']} n'est pas installé\nCommande: {cmd}\nCatégorie: {tool['cat']}\nLangages: {', '.join(tool['lang'])}",

            "stderr": "",

            "exit_code": 0,

            "success": True

        }

