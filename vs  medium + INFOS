                self._json({"success": True, "content": content, "path": file_path})

            else:

                self._json({"success": False, "error": "File not found"}, 404)

        elif path == "/api/tools":

            tools = {k: {"name": v["name"], "cat": v["cat"], "desc": v["desc"], "icon": v["icon"]}

                     for k, v in NEXUS_APIS.items()}

            cats = sorted(set(v["cat"] for v in NEXUS_APIS.values()))

            self._json({"tools": tools, "categories": cats})

        elif path == "/api/stats":

            self._json(STATS.to_dict())

        elif path == "/api/git/status":

            self._json(git_status())

        elif path == "/api/search":

            query = qs.get("q", [""])[0]

            results = []

            if query:

                for file in WORKSPACE_DIR.rglob("*"):

                    if file.is_file() and not file.name.startswith("."):

                        try:

                            content = file.read_text(errors="ignore")

                            for i, line in enumerate(content.split("\n"), 1):

                                if query.lower() in line.lower():

                                    results.append({

                                        "file": str(file.relative_to(WORKSPACE_DIR)),

                                        "line": f"L{i}: {line.strip()[:100]}"

                                    })

                                    if len(results) >= 50: break

                        except Exception:

                            pass

                    if len(results) >= 50: break

            self._json({"results": results[:50]})

        elif path == "/api/health":

            self._json({"status": "ok", "version": VERSION, "author": AUTHOR})

        else:

            self._json({"error": "not found"}, 404)



    def do_POST(self):

