def trouver_port(depart):

    for p in range(depart, depart + 20):

        try:

            with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:

                s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)

                s.bind(("0.0.0.0", p))

            return p

        except OSError:

            continue

    return None





