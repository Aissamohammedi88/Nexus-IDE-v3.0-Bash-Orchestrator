<body>
<div class="container">
<h1>🧬 Nexus Code Validator — Bash Edition</h1>
<p class="subtitle">8 validateurs · HTML · CSS · RSS · RDF · i18n · Links · EPUB · WPT · Port 8200</p>

<div class="badges">
<div class="badge">Bash pur</div>
<div class="badge">socat</div>
<div class="badge">jq</div>
<div class="badge">Port 8200</div>
<div class="badge">MPL 2.0</div>
</div>

<div class="panel">
<h2>📝 Code à valider</h2>
<textarea id="content"><!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<title>Test</title>
</head>
<body>
<h1>Bonjour</h1>
<img src="test.png">
</body>
</html></textarea>
</div>

<div class="panel">
<h2>⚙️ Validateurs</h2>
<div class="validators-grid">
<label class="v-check"><input type="checkbox" value="html" checked>HTML</label>
<label class="v-check"><input type="checkbox" value="css" checked>CSS</label>
<label class="v-check"><input type="checkbox" value="rss">RSS/Atom</label>
<label class="v-check"><input type="checkbox" value="rdf">RDF</label>
<label class="v-check"><input type="checkbox" value="i18n" checked>i18n</label>
<label class="v-check"><input type="checkbox" value="link" checked>Links</label>
<label class="v-check"><input type="checkbox" value="epub">EPUB</label>
<label class="v-check"><input type="checkbox" value="wpt">WPT</label>
</div>
<div class="actions">
<button class="btn" onclick="valider()">🔍 VALIDER</button>
<button class="btn green" onclick="validerTout()">⚡ TOUT</button>
<button class="btn red" onclick="document.getElementById('content').value=''">🗑️ VIDER</button>
</div>
</div>

<div class="panel" id="result-panel" style="display:none">
<h2>📊 Résultats</h2>
<div class="stats" id="stats"></div>
<div id="messages"></div>
<div class="result" id="raw-json"></div>
</div>

<div class="footer">Nexus Code Validator · Bash + socat · MPL 2.0 · Aissa Mohammedi (DGK)</div>
</div>

<script>
function esc(s){return String(s||'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}

function getSelected(){
return Array.from(document.querySelectorAll('.v-check input:checked')).map(i => i.value);
}

function showLoader(msg){
document.getElementById('result-panel').style.display = 'block';
document.getElementById('stats').innerHTML = '<div class="stat"><div class="l">Statut</div><div class="v">'+esc(msg)+'</div></div>';
document.getElementById('messages').innerHTML = '';
document.getElementById('raw-json').textContent = '';
}

async function valider(){
const content = document.getElementById('content').value;
const validators = getSelected();
if(!content.trim() || !validators.length) return;
showLoader('Validation...');
try{
const r = await fetch('/api/validate', {
method:'POST',
headers:{'Content-Type':'application/json'},
body: JSON.stringify({content, validators})
});
const d = await r.json();
render(d);
}catch(e){ document.getElementById('raw-json').textContent = 'Erreur: ' + e.message; }
}

async function validerTout(){
document.querySelectorAll('.v-check input').forEach(i => i.checked = true);
await valider();
}

function render(d){
const s = d.summary || {};
document.getElementById('stats').innerHTML =
'<div class="stat"><div class="l">Erreurs</div><div class="v '+((s.errors||0)>0?'danger':'ok')+'">'+(s.errors||0)+'</div></div>' +
'<div class="stat"><div class="l">Warnings</div><div class="v '+((s.warnings||0)>0?'warn':'ok')+'">'+(s.warnings||0)+'</div></div>' +
'<div class="stat"><div class="l">Info</div><div class="v">'+(s.info||0)+'</div></div>' +
'<div class="stat"><div class="l">Validateurs</div><div class="v">'+((d.validators_run||[]).length)+'</div></div>' +
'<div class="stat"><div class="l">Statut</div><div class="v '+(s.success?'ok':'danger')+'">'+(s.success?'OK':'ÉCHEC')+'</div></div>';

let msgs = '';
Object.entries(d.results || {}).forEach(([v, r]) => {
if (r.messages && r.messages.length){
r.messages.forEach(m => {
msgs += '<div class="msg '+esc(m.severity)+'">' +
'<span class="type">['+esc(v)+']</span> ' +
'<b>'+esc(m.severity)+'</b> ' +
esc(m.message) + '</div>';
});
}
});
if (!msgs) msgs = '<div class="msg info">✓ Aucun problème détecté</div>';
document.getElementById('messages').innerHTML = msgs;

document.getElementById('raw-json').textContent = JSON.stringify(d, null, 2);
}
</script>
</body>
</html>
HTML
}

