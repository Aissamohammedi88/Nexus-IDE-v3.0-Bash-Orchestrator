# MAIN
# ═══════════════════════════════════════════════════════════════════════════════

main() {
    banner

    # Vérifier dépendances
    for cmd in socat jq curl; do
        if ! command -v "$cmd" >/dev/null 2>&1; then
            ko "$cmd manquant"
            info "Installation : sudo apt install socat jq curl"
            exit 1
        fi
    done

    # Créer UI
    create_ui

    # Vérifier port
    if ss -tln 2>/dev/null | grep -q ":$PORT "; then
        warn "Port $PORT occupé"
        while ss -tln 2>/dev/null | grep -q ":$PORT "; do
            PORT=$((PORT + 1))
            (( PORT > 8300 )) && { ko "Aucun port libre 8200-8300"; exit 1; }
        done
        info "Utilisation du port $PORT"
    fi

    local ip_local
    ip_local=$(ip route get 1.1.1.1 2>/dev/null | awk '{print $7; exit}' || echo "127.0.0.1")

    ok "Serveur démarré"
    info "Port    : $PORT"
    info "Local   : http://localhost:$PORT/"
    info "Réseau  : http://$ip_local:$PORT/"
    info "API     : http://localhost:$PORT/api/validate"
    info "Log     : $LOG"
    printf '\n'
    warn "Ctrl+C pour arrêter"
    printf '\n'

    log "Server started on port $PORT"

    trap 'printf "\n"; info "Arrêt"; log "Server stopped"; exit 0' INT TERM

    # Ouvrir navigateur
    if command -v xdg-open >/dev/null 2>&1; then
        (sleep 1; xdg-open "http://localhost:$PORT/" >/dev/null 2>&1 &) || true
    fi

    socat TCP-LISTEN:"$PORT",reuseaddr,fork \
          EXEC:"bash -c 'handle_request'" 2>/dev/null
}

main "$@"
